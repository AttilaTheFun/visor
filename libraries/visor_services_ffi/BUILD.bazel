load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The client's services as swift_ffi interfaces, for the hosts that inject
# them across a boundary (a browser, an Android app): a host implements the
# bridges, and installBridgedVisorServices hands them to the client as its
# plain protocols.
swift_library(
    name = "visor_services_ffi",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorServicesFFI",
    # Only for those hosts (the web, Android: what Isomer runs on), not an
    # Apple build of Apple's SwiftUI, which injects nothing (a plain `bazel
    # build //...` there): its adapters hold the host's objects, made by its
    # bridge generator without Sendable, and are compiled by Isomer's rules.
    target_compatible_with = select({
        "@isomer//apple/compiled:feature_on": [],
        "@platforms//os:wasi": [],
        "@platforms//os:android": [],
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@isomer//swift_ffi/swift_ffi",
        "//libraries/visor_services",
    ],
)
