load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The client's services as swift_ffi interfaces, for the hosts that inject
# them across a boundary (a browser, an Android app): a host implements the
# bridges, and installBridgedVisorServices hands them to the client as its
# plain protocols.
swift_library(
    name = "visor_services_ffi",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorServicesFFI",
    deps = [
        "@isomer//swift_ffi/swift_ffi",
        "//libraries/visor_services",
    ],
)
