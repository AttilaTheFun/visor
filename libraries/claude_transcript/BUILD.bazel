load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Claude Code's session files, read as they are written: where a session's
# JSONL lives, what its records mean, and a watcher that hands over each
# record as it lands. Foundation only, so any host can take it.
