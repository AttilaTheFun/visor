load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The agent's host (visor-agent-host): one agent run apart from the server,
# on pipes, its latest lines kept for a server that connects again, its
# memory guarded. POSIX, through the server's C helpers.
swift_library(
    name = "visor_agent_host",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorAgentHost",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//:foundation",
        "//libraries/agent_host_wire",
        "//libraries/visor_server_posix:visor_posix_c",
    ],
)
