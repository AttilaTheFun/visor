load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The camera, for a photo to attach (`Camera.available`, and the
# `cameraCapture` modifier): UIKit's picker on an iPhone or iPad, none
# elsewhere. The default of `//:camera`; a host with a camera of its own
# gives a library of the same module name instead.
swift_library(
    name = "visor_camera",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorCamera",
    deps = [
        "//:foundation",
        "//:swift_ui",
    ],
)
