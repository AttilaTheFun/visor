load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# Visor's MCP server (`visor-agent-host mcp`): the tools every agent session
# is given, over its standard input and output, each call to the server on a
# WebSocket of its own. In Swift, so neither the Mac nor a container needs
# Node. POSIX, through the server's C helpers; Linux builds it with SwiftPM
# (Package.swift).
swift_library(
    name = "visor_mcp_bridge",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorMCPBridge",
    deps = [
        "//:foundation",
        "//libraries/visor_protocol",
        "//libraries/visor_server_posix:visor_posix_c",
    ],
)
