load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The server's platform on a Mac (ServerPlatform.apple): the Network
# framework's sockets, the keychain, CryptoKit and URLSession for pushes,
# ImageIO, the kernel's word on files, the app's relauncher — with the
# POSIX terminals and signals.
swift_library(
    name = "visor_server_apple",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorServerApple",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//libraries/claude_transcript",
        "//libraries/visor_protocol",
        "//libraries/visor_server",
        "//libraries/visor_server_posix",
        "//libraries/visor_server_ssh",
    ],
)
