load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Uninstall… (Visor Disk Utility's, its window's and its command line's):
# the plan of everything Visor left on this Mac outside its volumes, and the
# volumes themselves when their deletion is asked for, as a list of steps,
# from what a filesystem and a keychain say (UninstallFiles,
# UninstallKeychain: the Mac's in the app, fakes in the tests). Pure: it
# reads, never changes anything; the app runs the steps
# (applications/visor_disk_utility's UninstallRunner). Foundation alone:
# planned and tested on Linux (//tests/visor_uninstall_tests).
swift_library(
    name = "visor_uninstall",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorUninstall",
    deps = [
        "//:foundation",
        "//libraries/visor_disk_volumes",
    ],
)
