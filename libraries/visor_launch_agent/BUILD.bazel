load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# Visor's LaunchAgents on a Mac (LaunchAgentJob): jobs of this user's
# launchd that run Visor.app's own executable with an argument of their own,
# settled the same way: agent-proxy's (`--agent-proxy`, AgentProxyJob) and
# the server's (`--server`, ServerAgentJob: the server as a background
# agent, its hand-over from the app, ServerHandOver, and its restart and
# watch, ServerAgentRestart). launchctl is the Mac's alone; what's decided,
# and the watcher's script, build and are tested on Linux too
# (//tests/visor_launch_agent_tests).
swift_library(
    name = "visor_launch_agent",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorLaunchAgent",
    deps = [
        "//:foundation",
        "//libraries/visor_protocol",
        "//libraries/visor_server",
        "//libraries/visor_server_posix",
    ],
)
