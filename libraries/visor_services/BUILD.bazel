load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# What a host gives the client: a socket, HTTP, settings, notifications and
# a widget feed. The protocols are portable; the implementations beside
# them are what the iOS and Mac apps install. The socket, HTTP and settings
# ones are Foundation's alone (URLSession, UserDefaults, the keychain where
# there is one), so a host with another Foundation (its own) compiles them
# too; notifications, dictation, the network's state and SSH are Apple's.
swift_library(
    name = "visor_services",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]) + select({
        "@platforms//os:ios": glob(["native/*.swift"]),
        "@platforms//os:macos": glob(["native/*.swift"]),
        "//conditions:default": [],
    }),
    module_name = "VisorServices",
    deps = ["//:foundation"] + select({
        "@platforms//os:ios": ["//libraries/visor_ssh"],
        "@platforms//os:macos": ["//libraries/visor_ssh"],
        "//conditions:default": [],
    }),
)

# The portable implementations as sources (the socket, HTTP and settings:
# Foundation's alone), for a host that compiles them for another Foundation
# (Linux's, Windows') into a module of its own; the Apple-only ones stay out.
filegroup(
    name = "native_srcs",
    srcs = [
        "native/NativeVisorHTTPService.swift",
        "native/NativeVisorSettingsService.swift",
        "native/NativeVisorSocketService.swift",
        "native/VisorHTTPFailure.swift",
        "native/VisorSocketGone.swift",
    ],
)
