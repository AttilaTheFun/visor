load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# What a host gives the client: a socket, HTTP, settings, notifications and
# a widget feed. The protocols are portable; the Apple implementations
# (URLSession, UserDefaults, the keychain, UserNotifications) sit beside
# them and are what the iOS and Mac apps install.
swift_library(
    name = "visor_services",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]) + select({
        "@platforms//os:ios": glob(["native/*.swift"]),
        "@platforms//os:macos": glob(["native/*.swift"]),
        "//conditions:default": [],
    }),
    module_name = "VisorServices",
    deps = select({
        "@platforms//os:ios": ["@swiftpkg_swift_nio_ssh//:NIOSSH"],
        "@platforms//os:macos": ["@swiftpkg_swift_nio_ssh//:NIOSSH"],
        "//conditions:default": [],
    }),
)

# The Apple implementations as sources, for a host that compiles them for
# another Foundation (Linux, Windows) into a module of its own.
filegroup(
    name = "native_srcs",
    srcs = glob(["native/*.swift"]),
)
