load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# A server's socket file reached as the client reaches any server
# (SocketFileURL: `http+unix://…`): HTTP and the live channel's WebSocket
# over a connection to the socket file, and the host's HTTP and socket
# services wrapped to send those URLs there and the rest as before. What
# Visor on the Mac installs to reach its own server, in its process or the
# server agent's, with no password (docs/DEVELOPMENT.md, The server as a
# background agent). The connection itself is the host's to make
# (POSIXUnixSocket.connect), so this builds and is tested on Linux too.
swift_library(
    name = "visor_socket_file",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorSocketFile",
    deps = [
        "//:foundation",
        "//libraries/visor_protocol",
        "//libraries/visor_services",
        "//libraries/visor_system",
    ],
)
