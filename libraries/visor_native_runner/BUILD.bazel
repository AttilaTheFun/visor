load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# Visor's native runner: claims jobs from a dispatcher and runs each agent
# under agent-wrapper on this computer, on the Mac and Linux.
swift_library(
    name = "visor_native_runner",
    srcs = glob(["Sources/*.swift"]),
    copts = STRICT_SWIFT,
    module_name = "VisorNativeRunner",
    deps = [
        "//:foundation",
        "@swiftpkg_agent_protocol//:AgentProtocol",
        "@swiftpkg_grpc_swift_2//:GRPCCore",
        "@swiftpkg_grpc_swift_nio_transport//:GRPCNIOTransportHTTP2",
    ],
)
