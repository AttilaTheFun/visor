load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The server's SSH to its peers, over VisorSSH: what the Mac and Linux
# binaries give the server as its platform's `ssh`.
swift_library(
    name = "visor_server_ssh",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorServerSSH",
    deps = [
        "//libraries/visor_server",
        "//libraries/visor_ssh",
    ],
)
