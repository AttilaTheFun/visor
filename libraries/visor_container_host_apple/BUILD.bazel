load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The container host's secrets in the Mac's keychain, for notarized builds
# (tools/secrets): what a debug build keeps in a file of each container
# server's folder.
swift_library(
    name = "visor_container_host_apple",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorContainerHostApple",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//:foundation",
        "//libraries/visor_container_host",
    ],
)
