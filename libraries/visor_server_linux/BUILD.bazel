load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The command-line server's system on Linux: POSIX sockets and signals
# (visor_server_posix), the mount table, /proc, Foundation's networking
# (applications/visor_server_linux).
swift_library(
    name = "visor_server_linux",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorServerLinux",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:foundation",
        "//libraries/claude_transcript",
        "//libraries/visor_server",
        "//libraries/visor_server_cli",
        "//libraries/visor_server_posix",
        "//libraries/visor_system",
    ],
)
