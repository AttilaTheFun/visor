load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# Visor Runner (docs/co-tenancy.md): its MCP proxy, which every Visor
# server's MCP servers are set to (each server with a token of its own), the
# real headers kept by the Runner alone; its GitHub proxy and that proxy's
# own certificate authority (docs/github-proxy.md); its settings and secrets.
swift_library(
    name = "visor_runner",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorRunner",
    deps = [
        "//:foundation",
        "//libraries/visor_server_posix:visor_posix_c",
        "@swiftpkg_swift_asn1//:SwiftASN1",
        "@swiftpkg_swift_certificates//:X509",
        "@swiftpkg_swift_crypto//:Crypto",
        "@swiftpkg_swift_crypto//:_CryptoExtras",
        "@swiftpkg_swift_nio//:NIOCore",
        "@swiftpkg_swift_nio//:NIOHTTP1",
        "@swiftpkg_swift_nio//:NIOPosix",
        "@swiftpkg_swift_nio_ssl//:NIOSSL",
    ],
)
