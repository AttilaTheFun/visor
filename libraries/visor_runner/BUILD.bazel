    name = "visor_runner",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorRunner",
    deps = [
        "//:foundation",
        "//libraries/visor_server_posix:visor_posix_c",
    ],
