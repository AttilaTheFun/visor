load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The system pasteboard's text, as the client reads and writes it
# (`Pasteboard.string`): AppKit's on the Mac, UIKit's on an iPhone or iPad,
# none elsewhere. The default of `//:pasteboard`; a host with a clipboard of
# its own gives a library of the same module name instead.
swift_library(
    name = "visor_pasteboard",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorPasteboard",
)
