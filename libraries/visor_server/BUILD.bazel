load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The host side (macOS only): a WebSocket server on the Tailscale interface
# that authenticates clients by password and runs agent sessions — Claude
# Code and Codex as subprocesses whose JSON streams are normalised into the
# protocol's transcript entries.
swift_library(
    name = "visor_server",
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorServer",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//libraries/claude_transcript",
        "//libraries/message_cache",
        "//libraries/visor_protocol",
    ],
)
