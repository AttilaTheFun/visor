load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The server: a WebSocket and a REST listener on loopback that authenticate
# clients and run agent sessions — Claude Code, Codex and the rest as
# subprocesses whose JSON streams are normalised into the protocol's
# transcript entries. Nothing in it is particular to a system: what is
# (sockets, signals, secrets, pushes, …) is given by the binary that runs
# it, as a ServerPlatform (visor_server_apple for the menu bar app; the
# Linux and Windows command-line servers build with SwiftPM, Package.swift).
# Its one package beyond the repository's own: swift-crypto (Crypto), for
# the agents' tokens and the admin token.
swift_library(
    name = "visor_server",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorServer",
    # VisorSystem's and VisorAgent's `package` members are its to use.
    package_name = "visor",
    deps = [
        "//:foundation",
        "//libraries/agent_host_wire",
        "//libraries/claude_transcript",
        "//libraries/message_cache",
        "//libraries/visor_agent",
        "//libraries/visor_protocol",
        "//libraries/visor_system",
        # HMAC-SHA256 and SHA-256 for the agents' tokens (JWT) and the admin
        # token's hash: CryptoKit's API, on every system.
        "@swiftpkg_swift_crypto//:Crypto",
    ],
)
