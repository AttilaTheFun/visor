common --enable_bzlmod

# Modules from the project's registry first (isomer, and the forks it needs),
# then the Bazel Central Registry.
common --registry=https://raw.githubusercontent.com/AttilaTheFun/bazel_registry/main
common --registry=https://bcr.bazel.build

# isomer's hermetic Android NDK and SDK: their licenses, which resolving its
# toolchains needs even for a build only for Apple's platforms.
common --repo_env=ACCEPTED_ANDROID_NDK_LICENSE_VERSION=r30
common --repo_env=ACCEPTED_ANDROID_SDK_LICENSE_VERSION=35
common --android_platforms=@rules_android//:arm64-v8a

# rules_java's hermetic JDK 17, for rules_android's Java actions.
common --java_language_version=17
common --java_runtime_version=remotejdk_17
common --tool_java_language_version=17
common --tool_java_runtime_version=remotejdk_17
build --apple_platform_type=macos
build --macos_minimum_os=15.0
build --ios_minimum_os=18.0
# rules_swift_package_manager wraps every package target in a minimum-OS
# transition: with these already at the packages' values it changes nothing,
# so a package stays in its importer's configuration (otherwise isomer's
# modules build twice and clang refuses the second's module map).
build --minimum_os_version=15.0
build --host_macos_minimum_os=15.0

# swift_ffi's macro plugin (isomer's, for blue Visor's bridges) is built by
# the Xcode Swift toolchain; loaded inside the sandbox it can't reach the
# Swift runtime's dylibs, so Swift compiles run local.
build --strategy=SwiftCompile=local

# Isomer's Foundation, on the web and Android, with the dates and numbers the
# client formats (FoundationInternationalization).
build --@isomer//foundation:internationalization

# The Apple apps built on Linux with rules_applecross (MODULE.bazel), on a
# builder that has Xcode 27.2's SDK archive: its .bazelrc.user says where
# (`--distdir`, or a `--downloader_config` to a Shireworks server) and turns this
# on with `build:linux --config=apple_on_linux`. Without it (GitHub's
# runners) Linux builds what runs on Linux alone, and nothing fetches the
# SDKs. Its toolchains (the clean-room Apple tools, LLD, the Swift that
# built the SDKs) take the Apple targets; the host's own C and Swift
# toolchains still build what runs on Linux (Isomer's Linux pieces link its
# system libraries); rules_apple's own actions find the staged tools by
# DEVELOPER_DIR and PATH. A Mac builds as before, with its own Xcode.
startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1
common --enable_platform_specific_config
common --incompatible_repo_env_ignores_action_env
common:linux --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
build:apple_on_linux --extra_toolchains=@apple_cross_toolchain//:all
build:apple_on_linux --xcode_version_config=@apple_cross_toolchain//:host_xcodes
build:apple_on_linux --@rules_apple//apple:sdk_tool_files=@apple_cross_toolchain//:sdk_tool_files
build:apple_on_linux --action_env=DEVELOPER_DIR=external/rules_applecross++apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer
build:apple_on_linux --action_env=PATH=external/rules_applecross++apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:/bin:/usr/bin:/usr/local/bin
# For the Macs that run what is built: Apple silicon's Macs (Linux's own
# default is x86_64, which a Mac without Rosetta won't open). The iPhone's
# CPU is each build's own: --ios_multi_cpus accumulates rather than
# replaces, so a default here plus a device build's arm64 (--config=
# ci_device) made two slices, which no lipo here joins. A simulator build
# says --ios_multi_cpus=sim_arm64 (container_build.sh's CI run, the proof,
# blue's snapshots), as Linux's own default, x86_64, an Apple-silicon
# simulator refuses.
build:apple_on_linux --macos_cpus=arm64
# Its clean-room tools make a near match to Xcode's output where they cannot
# make it byte for byte (Visor's Icon Composer icon, drawn flat).
build:apple_on_linux --action_env=RULES_APPLECROSS_RESOURCE_OUTPUT_MODE=relaxed

# Isomer's Linux WebView (WebKitGTK) includes glibconfig.h and
# dbus-arch-deps.h from under /usr/lib, which Bazel accepts only as the cc
# toolchain's own include directories: given to the compiler it detects, as
# Isomer does, for Arch's layout and Debian's on x86_64 and arm64; missing
# directories are skipped.
common:linux --repo_env=C_INCLUDE_PATH=/usr/lib/glib-2.0/include:/usr/lib/dbus-1.0/include:/usr/lib/x86_64-linux-gnu/glib-2.0/include:/usr/lib/x86_64-linux-gnu/dbus-1.0/include:/usr/lib/aarch64-linux-gnu/glib-2.0/include:/usr/lib/aarch64-linux-gnu/dbus-1.0/include
build:linux --action_env=C_INCLUDE_PATH=/usr/lib/glib-2.0/include:/usr/lib/dbus-1.0/include:/usr/lib/x86_64-linux-gnu/glib-2.0/include:/usr/lib/x86_64-linux-gnu/dbus-1.0/include:/usr/lib/aarch64-linux-gnu/glib-2.0/include:/usr/lib/aarch64-linux-gnu/dbus-1.0/include

# Which build of an app this is, its Info.plist's BuildVariant
# (tools/variant): Alpha by default, every main, pull request and agent's
# build; Production only a release's.
build:alpha --//tools/variant:variant=alpha
build:beta --//tools/variant:variant=beta
build:prod --//tools/variant:variant=production
build:adhoc --//tools/variant:variant=adhoc
# CI's iPhone and iPad app: a device build, signed ad hoc with a placeholder
# profile (applications/visor_ios/BUILD.bazel), which Applications Server
# signs again with the team's identity and each bundle id's profile when it
# is published (tools/ci/publish_from_ci.sh).
build:ci_device --ios_multi_cpus=arm64
build:ci_device --ios_signing_cert_name=-

# Your own settings, such as the signing team (tools/signing).
try-import %workspace%/.bazelrc.user
