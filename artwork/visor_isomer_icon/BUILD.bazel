package(default_visibility = ["//visibility:public"])

# Visor's Icon Composer document (//artwork/app-icon) with the visor
# bar recoloured, one colour per way the client is built:
#   red    — compiled (Visor's own apps),
#   blue   — this one: the client as wasm, compiled ahead of time, in an iOS
#            16 shell (com.LoganShire.VisorIsomer),
#   yellow — an internal fork at work.
# Only Assets/Visor.svg differs from Visor's; keep the rest in step with it.
filegroup(
    name = "app_icon",
    srcs = glob(["VisorIsomer.icon/**"]),
)

# The Android launcher icon: the document's iOS rendition at 192 px, made
# with Icon Composer's command-line tool and sips:
#   ".../Icon Composer.app/Contents/Executables/ictool" VisorIsomer.icon --export-image \
#     --output-file /tmp/icon.png --platform iOS --rendition Default --width 1024 --height 1024 --scale 1
#   sips -z 192 192 /tmp/icon.png --out ic_launcher.png
exports_files(["ic_launcher.png"])
