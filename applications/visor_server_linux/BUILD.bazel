load("@rules_swift//swift:swift.bzl", "swift_binary")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# visor-server on Linux, and the agents' host when run by that name (a link
# to this program). The static release build is tools/linux_programs.sh's,
# with SwiftPM and the Static Linux SDK.
swift_binary(
    name = "visor-server",
    copts = STRICT_SWIFT,
    srcs = ["main.swift"],
    module_name = "VisorServerMain",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:foundation",
        "//libraries/visor_agent_host",
        "//libraries/visor_driver",
        "//libraries/visor_mcp_bridge",
        "//libraries/visor_native_runner",
        "//libraries/visor_server",
        "//libraries/visor_server_cli",
        "//libraries/visor_server_linux",
    ],
)
