load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Change to your own bundle id.
BUNDLE_ID = "com.LoganShire.Visor.macOS"

# The client on the Mac: the same compiled Swift + real SwiftUI the iOS app
# builds, on the shared host sources (the iOS @main is guarded by os(); the
# AppKit @main lives here).
swift_library(
    name = "macos_lib",
    srcs = glob(["Sources/**/*.swift"]) + ["//applications/visor_ios:host_srcs"],
    module_name = "VisorMacOSHost",
    deps = [
        "//libraries/visor_client",
        "//libraries/visor_services",
        "//libraries/visor_ui",
    ],
)

macos_application(
    name = "visor_macos",
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    resources = [
        # The flat icon, beside the compiled app icon.
        "//artwork/app-icon:Visor.icns",
    ],
    deps = [":macos_lib"],
)
