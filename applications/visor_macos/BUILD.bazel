load("//tools/swift:defs.bzl", "ISOMER_APPLE_DRIVER", "STRICT_SWIFT")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/app_groups:defs.bzl", "app_group_entitlements")
load("//tools/shared_sign_in:defs.bzl", "shared_sign_in_infoplist")
load("//tools/variant:defs.bzl", "variant_infoplist")

package(default_visibility = ["//visibility:public"])

# Change to your own bundle id.
BUNDLE_ID = "com.LoganShire.VisorClient.macOS"

# The entitlements, for the test that holds them to the sandboxed client's
# list, and the Info.plist, which turns ShakeKit on (tests/visor_macos_tests).
exports_files([
    "Info.plist",
    "app.ci.entitlements",
    "app.entitlements",
])

# Which build this is (tools/variant: Alpha unless a release's), and the
# app's name and link scheme: Visor Client, beside Visor.app, which takes
# the same links.
variant_infoplist(
    name = "variant_plist",
    display_name = "Visor Client",
    url_scheme = "visor",
)

# The app's own keychain access group (`<team>.com.LoganShire.VisorClient.macOS`,
# the data-protection keychain's: Sources/ClientKeychain.swift), which the
# Developer ID profile grants (its `<team>.*`). Its prefix is the builder's
# team here (a placeholder in CI: the ad hoc build has no profile to take it
# from), which CI's signing makes the profile's, with the application
# identifier beside it; as Visor.app's (applications/visor_mac). And
# Applications' app group (UPDATE_APP_GROUP, which CI's builds to publish
# set; tools/app_groups with none of the Visor family's), whose container
# holds the lock of the sign-in Logan's apps share (ShakeKit's), and, where
# the builder has that sign-in (tools/shared_sign_in), its keychain group,
# `<team>.com.LoganShire.github`: the Developer ID profile grants both.
app_group_entitlements(
    name = "app_ci_entitlements",
    groups = [],
    template = "app.ci.entitlements",
)

# ShakeKit's shared sign-in (GitHubShared…): in CI's builds alone, where the
# builder has it; every other build signs in with ShakeKit's own OAuth App.
shared_sign_in_infoplist(name = "shared_sign_in_plist")

# The client on the Mac: the same compiled Swift + real SwiftUI the iOS app
# builds, on the shared host sources (the iOS @main is guarded by os(); the
# AppKit @main lives here). Released as Visor Client (Logan, 21 Nov 2026),
# for a Mac that runs no server: sandboxed, its files in its container
# (~/Library/Containers/com.LoganShire.VisorClient.macOS) and its secrets
# in its own keychain group, with nothing of a server's (no socket file,
# launchd job, ~/.visor or ~/.ssh) and no SSH (Sources/VisorMacApp.swift).
swift_library(
    name = "macos_lib",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/**/*.swift"]) + ["//applications/visor_ios:host_srcs"],
    module_name = "VisorMacOSHost",
    deps = [
        "//:foundation",
        "@swiftpkg_shake_kit//:ShakeKit",
        "//libraries/visor_client",
        "//libraries/visor_protocol",
        "//libraries/visor_services",
        "//libraries/visor_ui",
    ],
)

# CI's builds to publish (--config=ci_device, .bazelrc), signed ad hoc for
# Shireworks' signing to sign again (applications/visor_mac's ci_signed).
config_setting(
    name = "ci_signed",
    values = {"ios_signing_cert_name": "-"},
)

macos_application(
    name = "visor_macos",
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Visor Client",
    # The App Sandbox, the network as a client, the microphone (dictation)
    # and the files the person picks, read only (attachments, an archive to
    # import), in every build; and push, the app's keychain access group
    # and Applications' app group (with the shared sign-in's keychain group
    # where CI has it) in a build CI publishes, which Shireworks' signing
    # signs again with the Developer ID profile, taking push's value from
    # it. A build to run here asks for none: a restricted entitlement with
    # no profile to allow it stops the app at launch (its secrets then stay
    # in the login keychain). Nothing else (tests/visor_macos_tests).
    entitlements = select({
        ":ci_signed": ":app_ci_entitlements",
        "//conditions:default": "app.entitlements",
    }),
    infoplists = [
        "Info.plist",
        ":variant_plist",
    ] + select({
        ":ci_signed": [":shared_sign_in_plist"],
        "//conditions:default": [],
    }),
    minimum_os_version = "15.0",
    # Isomer's driver with --config=drive alone (tools/swift/defs.bzl).
    deps = [":macos_lib"] + ISOMER_APPLE_DRIVER,
)
