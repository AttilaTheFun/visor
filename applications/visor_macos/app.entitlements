<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Visor Client is sandboxed: its files in its container alone. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Its computers, over HTTP, HTTPS and WebSockets: out, never in. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Dictation: the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The files the person picks or drops, read only: attachments, and
	     a session archive to import. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
