load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_library")

package(default_visibility = ["//visibility:public"])

# The client on linux: visor's libraries under isomer's SwiftUI, with
# visor's own Foundation implementations of its services compiled here
# for this platform's Foundation. Built on a linux host (unverifiable from a Mac).
swift_library(
    name = "native_services",
    srcs = [
        "NativeServicesImports.swift",
        "//libraries/visor_services:native_srcs",
    ],
    module_name = "VisorServicesNative",
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//libraries/visor_services"],
)

swift_binary(
    name = "visor_client_linux",
    srcs = ["App.swift"],
    copts = ["-parse-as-library"],
    module_name = "VisorDesktop",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":native_services",
        "@isomer//linux/libraries/swift_ui",
        "@isomer//linux/libraries/swift_ui:isomer_bridge",
        "//libraries/visor_client",
        "//libraries/visor_services",
        "//libraries/visor_ui",
    ],
)
