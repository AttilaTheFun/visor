load("//tools/swift:defs.bzl", "ISOMER_APPLE_DRIVER", "STRICT_SWIFT")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/app_groups:defs.bzl", "app_group_entitlements")
load("//tools/shared_sign_in:defs.bzl", "shared_sign_in_infoplist")
load("//tools/signing:defs.bzl", "update_infoplist")
load("//tools/variant:defs.bzl", "variant_infoplist")

package(default_visibility = ["//visibility:public"])

# The server agent's plist, for the bundle and for its test
# (//tests/visor_launch_agent_tests, which checks it is ServerAgentJob's).
exports_files(["LaunchAgents/com.LoganShire.Visor.server.plist"])

# The Info.plist, for the test that holds ShakeKit on in every build
# (tests/visor_macos_tests).
exports_files(["Info.plist"])

BUNDLE_ID = "com.LoganShire.Visor"

# Which build this is (tools/variant: Alpha unless a release's), and the
# app's name and link scheme, the same in every build and as the iPhone's.
variant_infoplist(
    name = "variant_plist",
    display_name = "Visor",
    url_scheme = "visor",
)

# The app group shared with Applications and Applications' bundle ids, for
# UpdateKit (tools/signing; CI's distribution builds set them). The group's
# entitlement is in CI's builds alone: outside the Mac App Store a `group.`
# group needs a Developer ID profile that grants it, or macOS asks at
# launch, and Shireworks' signing embeds that profile as it signs them. A
# build to run here names none, so UpdateKit finds no container and does
# nothing.
update_infoplist(name = "update_plist")

# And the Visor family's app group, `group.com.LoganShire.Visor`, beside
# Applications' (tools/app_groups: the sockets in its container, 0.66
# behind a setting, and the sandboxed release's, docs/sandboxed.md), and the
# app's own keychain access group (`<team>.com.LoganShire.Visor`, the
# data-protection keychain's: Sources/MacSecrets.swift), which the Developer
# ID profile grants too (its `<team>.*`, and both groups since 22 Nov 2026).
# Its prefix is the builder's team here (a placeholder in CI: the ad hoc
# build has no profile to take it from), which CI's signing makes the
# profile's, with the application identifier beside it.
# And, where the builder has it (tools/shared_sign_in: CI's builds to
# publish), the keychain group of the sign-in Logan's apps share
# (`<team>.com.LoganShire.github`, ShakeKit's), which the profile's
# `<team>.*` grants; its lock is in Applications' group, above.
app_group_entitlements(
    name = "app_ci_entitlements",
    template = "app.ci.entitlements",
)

# ShakeKit's shared sign-in (GitHubShared…): in CI's builds alone, where the
# builder has it. It is ShakeKit's only sign-in (shake_kit 0.3): every other
# build, or a Mac not signed in to Shireworks, reports nothing.
shared_sign_in_infoplist(name = "shared_sign_in_plist")

# Visor on the Mac: a menu bar app whose
# window is Visor's macOS client, with the Mac's Visor server under it. It
# took over from Visor Server (applications/visor_menubar) and the Mac
# client (applications/visor_macos) in 0.46, and keeps what it has in places
# of its own (Sources/MacPlaces.swift). The same executable is the server
# agent with `--server` (Sources/MacServerAgent.swift: the server headless,
# a launchd job, while the app's `ServerAsAgent` default is on) and
# agent-proxy with `--agent-proxy`. The app is its server's client alone,
# its window, menu and Settings alike, at the server's socket file
# (Sources/LocalServer.swift, //libraries/visor_socket_file), whichever
# process runs it.
swift_library(
    name = "mac_lib",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]) + [
        "//applications/visor_ios:host_srcs",
        "//applications/visor_menubar:shared_srcs",
    ],
    module_name = "VisorMac",
    deps = [
        "//:foundation",
        "@swiftpkg_shake_kit//:ShakeKit",
        "@swiftpkg_update_kit//:UpdateKit",
        "//libraries/message_cache",
        "//libraries/visor_agent_proxy:visor_agent_proxy_host",
        "//libraries/visor_client",
        # The Sessions container's readiness in Settings, on Apple's
        # Containerization (the Mac's alone).
        "//libraries/visor_container",
        "//libraries/visor_container:visor_container_core",
        "//libraries/visor_container:visor_container_runner",
        "//libraries/visor_disk_volumes",
        "//libraries/visor_driver",
        "//libraries/visor_launch_agent",
        "//libraries/visor_native_runner",
        "//libraries/visor_protocol",
        "//libraries/visor_server",
        "//libraries/visor_server_apple",
        "//libraries/visor_server_cli",
        "//libraries/visor_server_posix",
        "//libraries/visor_services",
        "//libraries/visor_socket_file",
        "//libraries/visor_system",
        "//libraries/visor_ui",
        "//libraries/visor_update_install",
    ],
)

# CI's builds to publish (--config=ci_device, .bazelrc), signed ad hoc for
# Shireworks' signing to sign again (applications/visor_ios's ci_device).
config_setting(
    name = "ci_signed",
    values = {"ios_signing_cert_name": "-"},
)

macos_application(
    name = "visor_mac",
    # The agents' host beside the app's own program, as in Visor Server:
    # each session's agent runs under one.
    # And agent_protocol's agent-wrapper, which the native runner runs each
    # of its agents under.
    # And the server agent's launchd plist (ServerAgentJob), registered
    # with SMAppService from the bundle, so none is written outside it: at
    # Contents/Library/LaunchAgents (the file keeps its own folder's name).
    additional_contents = {
        "//applications/agent_wrapper:agent-wrapper": "Helpers",
        "//applications/visor_agent_host:visor-agent-host": "Helpers",
        "LaunchAgents/com.LoganShire.Visor.server.plist": "Library",
    },
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Visor",
    # The hardened runtime's own (the microphone); and push in a build CI
    # publishes, which Shireworks' signing signs again with the Developer
    # ID profile, taking push's value from it, but only for an app that
    # asks for push; and the app group and the app's keychain access group,
    # which the profile grants. A build to run here asks for none: a restricted
    # entitlement with no profile to allow it stops the app at launch (its
    # app key stays in the login keychain: Sources/MacSecrets.swift).
    # Virtualization (the Sessions container's VM, docs/containers.md) in
    # both: it's unrestricted, so no profile need grant it, and an ad hoc
    # build opens with it.
    entitlements = select({
        ":ci_signed": ":app_ci_entitlements",
        "//conditions:default": "app.entitlements",
    }),
    infoplists = [
        "Info.plist",
        ":update_plist",
        ":variant_plist",
    ] + select({
        ":ci_signed": [":shared_sign_in_plist"],
        "//conditions:default": [],
    }),
    minimum_os_version = "15.0",
    # Isomer's driver with --config=drive alone (tools/swift/defs.bzl).
    deps = [":mac_lib"] + ISOMER_APPLE_DRIVER,
)
