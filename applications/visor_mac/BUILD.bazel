load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/variant:defs.bzl", "variant_infoplist")

package(default_visibility = ["//visibility:public"])

BUNDLE_ID = "com.LoganShire.Visor"

# Which build this is (tools/variant: Alpha unless a release's), and the
# app's name and link scheme, the same in every build and as the iPhone's.
variant_infoplist(
    name = "variant_plist",
    display_name = "Visor",
    url_scheme = "visor",
)

# Visor on the Mac (docs/co-tenancy.md, "The app"): a menu bar app whose
# window is Visor's macOS client, with the Mac's Visor server under it. It
# took over from Visor Server (applications/visor_menubar) and the Mac
# client (applications/visor_macos) in 0.46, and keeps what it has in places
# of its own (Sources/MacPlaces.swift).
swift_library(
    name = "mac_lib",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]) + [
        "//applications/visor_ios:host_srcs",
        "//applications/visor_menubar:shared_srcs",
    ],
    module_name = "VisorMac",
    deps = [
        "//:foundation",
        "@swiftpkg_applications//:ApplicationUpdates",
        "//libraries/message_cache",
        "//libraries/visor_client",
        "//libraries/visor_protocol",
        "//libraries/visor_server",
        "//libraries/visor_server_apple",
        "//libraries/visor_services",
        "//libraries/visor_ui",
    ],
)

# CI's builds to publish (--config=ci_device, .bazelrc), signed ad hoc for
# Applications Server to sign again (applications/visor_ios's ci_device).
config_setting(
    name = "ci_signed",
    values = {"ios_signing_cert_name": "-"},
)

macos_application(
    name = "visor_mac",
    # The agents' host beside the app's own program, as in Visor Server:
    # each session's agent runs under one. And Visor's container host.
    additional_contents = {
        "//applications/visor_agent_host:visor-agent-host": "Helpers",
        "//applications/visor_container_host:visor-container-host": "Helpers",
    },
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Visor",
    # The hardened runtime's own (the microphone); and push in a build CI
    # publishes, which Applications Server signs again with the Developer
    # ID profile, taking push's value from it, but only for an app that
    # asks for push. A build to run here asks for none: a restricted
    # entitlement with no profile to allow it stops the app at launch.
    entitlements = select({
        ":ci_signed": "app.ci.entitlements",
        "//conditions:default": "app.entitlements",
    }),
    infoplists = [
        "Info.plist",
        ":variant_plist",
    ],
    minimum_os_version = "15.0",
    deps = [":mac_lib"],
)
