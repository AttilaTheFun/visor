load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:tvos.bzl", "tvos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcode_provisioning_profile")
load("@visor_signing//:signing.bzl", "TEAM_ID")

package(default_visibility = ["//visibility:public"])

# Change to your own bundle id.
BUNDLE_ID = "com.LoganShire.VisorClient.tvOS"

# The client on an Apple TV: the same client and views as the Mac and the
# phone — the split view across the screen, driven by the remote's focus —
# with the composer's dictation through the system keyboard.
swift_library(
    name = "tvos_lib",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "VisorTVOSHost",
    deps = [
        "//libraries/visor_client",
        "//libraries/visor_services",
        "//libraries/visor_ui",
    ],
)

# Device signing: the team's development profile for this bundle id
# (tools/mint_profile with `tvos` makes it, the TV paired with Xcode).
# Simulator builds ignore it.
local_provisioning_profile(
    name = "app_local_profile",
    profile_name = "tvOS Team Provisioning Profile: " + BUNDLE_ID,
    tags = ["manual"],
    team_id = TEAM_ID,
)

xcode_provisioning_profile(
    name = "app_profile",
    managed_by_xcode = True,
    provisioning_profile = ":app_local_profile",
    tags = ["manual"],
)

tvos_application(
    name = "visor_tvos",
    bundle_id = BUNDLE_ID,
    families = ["tv"],
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    provisioning_profile = select({
        "@apple_support//constraints:device": ":app_profile",
        "//conditions:default": None,
    }),
    deps = [":tvos_lib"],
)
