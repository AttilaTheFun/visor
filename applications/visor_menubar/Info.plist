<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Visor Server</string>
    <key>CFBundleDisplayName</key>
    <string>Visor Server</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.24</string>
    <key>CFBundleVersion</key>
    <string>24</string>
    <!-- The app it takes over from, by bundle id: an update from it
         installs this beside it and removes it (Server.relaunch). -->
    <key>VisorReplaces</key>
    <array>
        <string>com.LoganShire.Visor.MenuBar</string>
    </array>
    <!-- A server may be plain http:// on a LAN or a VPN, which ATS would
         otherwise refuse as cleartext. Arbitrary loads alone: with
         NSAllowsLocalNetworking beside it, ATS ignores it. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- A menu bar app: no Dock icon, no app menu. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string></string>
</dict>
</plist>
