load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Change to your own bundle id.
BUNDLE_ID = "com.LoganShire.Visor.MenuBar"

# The host: a menu bar app (no Dock icon) running the Visor server. The menu
# shows the Tailscale address, the password to type on a client, the
# connected clients and the running sessions.
swift_library(
    name = "menubar_lib",
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorMenuBar",
    deps = [
        "//libraries/visor_protocol",
        "//libraries/visor_server",
    ],
)

macos_application(
    name = "visor_menubar",
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    resources = [
        # Claude's permission prompt tool for manual mode (docs/protocol.md).
        "Resources/visor_approve_mcp.js",
        # The flat icon, beside the compiled app icon.
        "//artwork/app-icon:Visor.icns",
    ],
    deps = [":menubar_lib"],
)
