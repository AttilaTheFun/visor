load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Change to your own bundle id.
BUNDLE_ID = "com.LoganShire.VisorServer.macOS"

# The host: Visor Server, a menu bar app (no Dock icon) running the server. The menu
# shows the address clients take, the password to type on a client, the
# connected clients and the running sessions.
swift_library(
    name = "menubar_lib",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorMenuBar",
    deps = [
        "//:foundation",
        "//libraries/visor_protocol",
        "//libraries/visor_runner",
        "//libraries/visor_server",
        "//libraries/visor_server_apple",
    ],
)

# The Runner's agent's launchd plist (docs/co-tenancy.md), named and labelled
# after the app's bundle id: the app registers it with SMAppService from its
# own bundle, its program the agent in Contents/Helpers.
genrule(
    name = "runner_agent_plist",
    outs = [BUNDLE_ID + ".runner-agent.plist"],
    cmd = """cat > $@ <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{label}</string>
    <key>BundleProgram</key>
    <string>Contents/Helpers/visor-runner-agent</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>{bundle}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
PLIST
""".format(bundle = BUNDLE_ID, label = BUNDLE_ID + ".runner-agent"),
)

macos_application(
    name = "visor_menubar",
    # The agents' host, beside the app's own program: each session's agent
    # runs under one, so a restart of the server leaves it working. And
    # Visor's container host, used once it is linked onto the PATH or set
    # (docs/container-host.md).
    additional_contents = {
        "//applications/visor_agent_host:visor-agent-host": "Helpers",
        "//applications/visor_container_host:visor-container-host": "Helpers",
        "//applications/visor_runner_agent:visor-runner-agent": "Helpers",
        ":runner_agent_plist": "Library/LaunchAgents",
    },
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Visor Server",
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    deps = [":menubar_lib"],
)
