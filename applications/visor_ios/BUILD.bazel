load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcode_provisioning_profile")

package(default_visibility = ["//visibility:public"])

# Signing: change these to your own bundle id and Apple team id (Xcode →
# Settings → Accounts shows the team). The provisioning profile is the one
# Xcode makes for the bundle id; tools/mint_profile makes it on a new Mac.
BUNDLE_ID = "com.LoganShire.Visor"

TEAM_ID = "9CLW2BBDAG"

# The client on a phone: compiled Swift, real SwiftUI, the shared VisorUI
# screens. The host sources are shared with the Mac client (a filegroup);
# only the @main is guarded by os().
filegroup(
    name = "host_srcs",
    srcs = glob(["Sources/**/*.swift"]),
)

swift_library(
    name = "ios_lib",
    srcs = [":host_srcs"],
    module_name = "VisorIOSHost",
    deps = [
        "//libraries/visor_client",
        "//libraries/visor_services",
        "//libraries/visor_ui",
    ],
)

# Device signing: the Xcode-managed development profile for the bundle id
# (free-team profiles last 7 days and embed the connected phone's UDID).
# Simulator builds ignore it.
local_provisioning_profile(
    name = "local_profile",
    profile_name = "iOS Team Provisioning Profile: " + BUNDLE_ID,
    tags = ["manual"],
    team_id = TEAM_ID,
)

xcode_provisioning_profile(
    name = "xcode_managed_profile",
    managed_by_xcode = True,
    provisioning_profile = ":local_profile",
    tags = ["manual"],
)

ios_application(
    name = "visor_ios",
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "18.0",
    provisioning_profile = select({
        "@apple_support//constraints:device": ":xcode_managed_profile",
        "//conditions:default": None,
    }),
    deps = [":ios_lib"],
)
