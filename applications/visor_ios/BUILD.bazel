load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application", "ios_extension")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcode_provisioning_profile")
load("@visor_signing//:signing.bzl", "TEAM_ID")
load("//tools/variant:defs.bzl", "variant_infoplist")

package(default_visibility = ["//visibility:public"])

# Signing: the bundle id here, and your Apple team id in .bazelrc.user
# (`common --repo_env=VISOR_TEAM_ID=<team>`, see tools/signing), which is
# not checked in. The provisioning profile is the one Xcode makes for the
# bundle id; tools/mint_profile makes it on a new Mac.
# Visor's one id, the Mac's Visor.app's too (from 0.43; the iPhone's was
# com.LoganShire.VisorClient.iOS, whose keychain the new id cannot read: the
# computers are added again once).
BUNDLE_ID = "com.LoganShire.Visor"

# Which build this is (tools/variant: Alpha unless a release's), and the
# app's name and link scheme, the same in every build.
variant_infoplist(
    name = "variant_plist",
    display_name = "Visor",
    url_scheme = "visor",
)

# The client on a phone: compiled Swift, real SwiftUI, the shared VisorUI
# screens. The host sources are shared with the Mac client (a filegroup);
# only the @main is guarded by os().
filegroup(
    name = "host_srcs",
    srcs = glob(["Sources/**/*.swift"]),
)

swift_library(
    name = "ios_lib",
    copts = STRICT_SWIFT,
    srcs = [":host_srcs"],
    module_name = "VisorIOSHost",
    deps = [
        "//:foundation",
        "@swiftpkg_applications//:ApplicationUpdates",
        "//libraries/visor_client",
        "//libraries/visor_protocol",
        "//libraries/visor_services",
        "//libraries/visor_ui",
    ],
)

# Device signing: the team's Xcode-managed wildcard development profile (a
# year long, listing the team's registered devices; tools/mint_profile makes
# it). Simulator builds ignore it.
local_provisioning_profile(
    name = "local_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = TEAM_ID,
)

xcode_provisioning_profile(
    name = "xcode_managed_profile",
    managed_by_xcode = True,
    provisioning_profile = ":local_profile",
    tags = ["manual"],
)

# The app itself needs a profile of its own: push notifications
# (aps-environment) are a capability of an explicit App ID, which the
# wildcard profile cannot carry. Xcode makes it; tools/mint_profile with the
# app's entitlements makes it on a new Mac. The widget keeps the wildcard.
local_provisioning_profile(
    name = "app_local_profile",
    profile_name = "iOS Team Provisioning Profile: " + BUNDLE_ID,
    tags = ["manual"],
    team_id = TEAM_ID,
)

xcode_provisioning_profile(
    name = "app_profile",
    managed_by_xcode = True,
    provisioning_profile = ":app_local_profile",
    tags = ["manual"],
)

# CI's device build (--config=ci_device, .bazelrc): CI holds no profile of
# the team's, so it signs ad hoc (--ios_signing_cert_name=-) with this
# placeholder, the app and its widget alike, which allows what their
# entitlements ask for (push, the keychain group, the Applications group).
# Applications Server replaces both, the profiles and the signatures, with
# each bundle id's own (AttilaTheFun/applications' docs/CI.md, "What the
# server does with each build"). A plain plist: rules_applecross reads the
# plist in a profile off a Mac, so this builds on Linux alone, as CI does.
# The setting refines the device's alone, so the selects below take it.
config_setting(
    name = "ci_device",
    constraint_values = ["@apple_support//constraints:device"],
    values = {"ios_signing_cert_name": "-"},
)

genrule(
    name = "ci_placeholder_profile",
    outs = ["ci_placeholder.mobileprovision"],
    cmd = """cat > $@ <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIDName</key>
	<string>Visor (CI placeholder)</string>
	<key>ApplicationIdentifierPrefix</key>
	<array>
		<string>{team}</string>
	</array>
	<key>CreationDate</key>
	<date>2026-01-01T00:00:00Z</date>
	<key>DeveloperCertificates</key>
	<array>
	</array>
	<key>Entitlements</key>
	<dict>
		<key>application-identifier</key>
		<string>{team}.*</string>
		<key>aps-environment</key>
		<string>development</string>
		<key>com.apple.developer.team-identifier</key>
		<string>{team}</string>
		<key>com.apple.security.application-groups</key>
		<array>
			<string>group.com.LoganShire.Applications</string>
		</array>
		<key>get-task-allow</key>
		<true/>
		<key>keychain-access-groups</key>
		<array>
			<string>{team}.*</string>
		</array>
	</dict>
	<key>ExpirationDate</key>
	<date>2036-01-01T00:00:00Z</date>
	<key>Name</key>
	<string>Visor CI placeholder</string>
	<key>Platform</key>
	<array>
		<string>iOS</string>
	</array>
	<key>ProvisionedDevices</key>
	<array>
	</array>
	<key>TeamIdentifier</key>
	<array>
		<string>{team}</string>
	</array>
	<key>TeamName</key>
	<string>CI placeholder</string>
	<key>TimeToLive</key>
	<integer>3652</integer>
	<key>UUID</key>
	<string>00000000-0000-4000-8000-0000000000c3</string>
	<key>Version</key>
	<integer>1</integer>
</dict>
</plist>
EOF""".format(team = TEAM_ID),
)

# The home screen's widget: the latest sessions, as the app keeps them in a
# keychain group the two share (app.entitlements, Widget/widget.entitlements;
# the wildcard profile allows any group under the team's prefix, which
# signing fills in).
swift_library(
    name = "widget_lib",
    copts = STRICT_SWIFT,
    srcs = glob(["Widget/*.swift"]),
    module_name = "VisorWidget",
    deps = ["//:foundation"],
)

ios_extension(
    name = "visor_widget",
    bundle_id = BUNDLE_ID + ".Widget",
    # The simulator has no profile to take the team's prefix from: the
    # group goes by its name alone there.
    entitlements = select({
        "@apple_support//constraints:device": "Widget/widget.entitlements",
        "//conditions:default": "Widget/widget.simulator.entitlements",
    }),
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Widget/Info.plist"],
    minimum_os_version = "18.0",
    provisioning_profile = select({
        ":ci_device": ":ci_placeholder_profile",
        "@apple_support//constraints:device": ":xcode_managed_profile",
        "//conditions:default": None,
    }),
    deps = [":widget_lib"],
)

ios_application(
    name = "visor_ios",
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    entitlements = select({
        "@apple_support//constraints:device": "app.entitlements",
        "//conditions:default": "app.simulator.entitlements",
    }),
    extensions = [":visor_widget"],
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = [
        "Info.plist",
        ":variant_plist",
    ],
    minimum_os_version = "18.0",
    provisioning_profile = select({
        ":ci_device": ":ci_placeholder_profile",
        "@apple_support//constraints:device": ":app_profile",
        "//conditions:default": None,
    }),
    deps = [":ios_lib"],
)
