load("@rules_swift//swift:swift.bzl", "swift_binary")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

# The client headless: VisorRootView on Isomer's headless host
# (@isomer//headless/libraries/swift_ui), nothing drawn, its screen read and
# used through Isomer's driver protocol over standard input and output (or
# the socket a test's HeadlessApp gives it). On the building machine: a
# Linux container (never a Mac's own disk here; AGENTS.md). For the driver
# tests (//tests/feature_map_tests) and for an agent finding its way around
# the client with `iso`. Built with --config=headless:
#
#   bazel build --config=headless //applications/visor_headless
#   env fixture=snapshot fixture.screen=chat bazel-bin/applications/visor_headless/visor_headless
#   {"cmd": "ls"}
#
# Its settings are in memory, seeded at launch from the environment (the
# keys Android's intent extras use: `fixture`, `fixture.screen`, …) and from
# `-visor.<key> <value>` arguments (the iPhone's launch arguments). It has no
# network: it is for the fixture (`fixture=snapshot`), whose computer is
# canned (VisorFixture).
swift_binary(
    name = "visor_headless",
    srcs = glob(["Sources/*.swift"]),
    copts = STRICT_SWIFT + ["-parse-as-library"],
    module_name = "VisorHeadless",
    # Only with --config=headless (skipped otherwise, as by `//...`).
    target_compatible_with = select({
        "@isomer//headless:on": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//:foundation",
        "//libraries/visor_client",
        "//libraries/visor_services",
        "//libraries/visor_ui",
        "@isomer//headless/libraries/swift_ui",
        "@isomer//headless/libraries/swift_ui:isomer",
        "@swiftpkg_agent_ui//:AgentUI",
    ],
)
