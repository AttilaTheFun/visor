load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/app_groups:defs.bzl", "app_group_entitlements")
load("//tools/variant:defs.bzl", "variant_infoplist")

package(default_visibility = ["//visibility:public"])

BUNDLE_ID = "com.LoganShire.Visor.DiskUtility"

# Which build this is (tools/variant), and its name, as Visor's.
variant_infoplist(
    name = "variant_plist",
    display_name = "Visor Disk Utility",
)

# Visor Disk Utility: a small app of its own, beside Visor.app (Logan, 19
# Nov 2026), that creates the three APFS volumes Visor keeps what is its
# own on, Sessions, Sources and Visor (libraries/visor_disk_volumes), with
# macOS's administrator prompt for diskutil, checks that each is as it
# should be (mounted where Visor looks, case-sensitive, the person's, and
# Visor's out of Time Machine and Spotlight), and writes volumes.json for
# Visor. Nothing else (Logan, 24 Nov 2026): no conversion of a volume, no
# migration and no uninstall; with everything of Visor's on its volumes, a
# person removes it by deleting them in Apple's Disk Utility. Its command
# line (`status`, `create`, `fix-owner`, `exclude-visor`,
# `erase-containers`) runs the same code, for scripts, NCH over SSH and
# test machines.
swift_library(
    name = "disk_utility_lib",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "VisorDiskUtility",
    deps = [
        "//:foundation",
        "//libraries/visor_disk_volumes",
    ],
)

# The CI build's entitlements: its own identifier, Visor's keychain access
# group, and the app groups, the Visor family's and Applications'
# (tools/app_groups), the team prefix the builder's here (a placeholder in
# CI), which CI's signing makes the profile's (tools/signing). Uninstall…
# was what used the keychain group and the group's container; since it
# went (Logan, 24 Nov 2026) nothing here does; they're kept so CI's
# signing of it, and its profile, stay as they were, and go with a change
# to that signing.
app_group_entitlements(
    name = "app_ci_entitlements",
    template = "app.ci.entitlements",
)

macos_application(
    name = "visor_disk_utility",
    app_icons = ["//artwork/app-icon:app_icon"],
    bundle_id = BUNDLE_ID,
    bundle_name = "Visor Disk Utility",
    # Not sandboxed (it runs diskutil and osascript), and the hardened
    # runtime needs nothing for that. A build CI publishes asks for the app
    # groups and Visor's own keychain access group
    # (`<team>.com.LoganShire.Visor`), as Visor.app's build does
    # (applications/visor_mac): Shireworks' signing makes the prefix its
    # Developer ID profile's, which must grant the groups (the team's
    # `<team>.*`, and both app groups). A build to run here asks for none.
    entitlements = select({
        "//applications/visor_mac:ci_signed": ":app_ci_entitlements",
        "//conditions:default": None,
    }),
    infoplists = [
        "Info.plist",
        ":variant_plist",
    ],
    minimum_os_version = "15.0",
    deps = [":disk_utility_lib"],
)
