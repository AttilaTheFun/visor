load("@rules_swift//swift:swift.bzl", "swift_binary")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# relay-client, inside a relayed container (docs/agent-proxy.md): its
# traffic relayed to agent-proxy over the relay's socket. Linux alone. The
# static build that ships is visor-server run by this name (a link to it in
# the Mac app's Resources/Linux, for the container runner to mount):
# tools/linux_programs.sh's, with SwiftPM.
swift_binary(
    name = "relay-client",
    copts = STRICT_SWIFT,
    srcs = ["main.swift"],
    module_name = "RelayClientMain",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:foundation",
        "//libraries/visor_agent_proxy:visor_relay_client",
    ],
)
