"""Visor — remote agent sessions: a Mac menu bar app that runs Claude Code and
Codex sessions and exposes them over Tailscale, and a SwiftUI client for
iPhone, iPad and Mac that drives them."""

module(
    name = "visor",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.8.4")
bazel_dep(name = "rules_swift", version = "4.1.0")

# The server's one C file (libraries/visor_server_posix/c); already in the
# graph at this version through rules_swift.
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_apple", version = "5.1.0")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.24.1")

# SQLite for the message cache, on every host: swift_sqlite (the system's
# SQLite on Apple's platforms, its vendored amalgamation elsewhere, WASI
# included), pinned by commit; at a release, its tag's.
bazel_dep(name = "swift_sqlite", version = "0.34")
git_override(
    module_name = "swift_sqlite",
    commit = "4e6ff38833917d660875890effb9496cffd06b22",
    remote = "https://github.com/AttilaTheFun/swift_sqlite.git",
)

# The chat, composer and navigation views: the agent_ui package, pinned by
# revision in third_party/swift_packages.
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//third_party/swift_packages:Package.resolved",
    swift = "//third_party/swift_packages:Package.swift",
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_agent_ui",
    "swiftpkg_swift_nio_ssh",
)

# The builder's own signing values (the Apple team), from .bazelrc.user.
signing = use_extension("//tools/signing:extension.bzl", "signing")
use_repo(signing, "visor_signing")
