"""Visor — remote agent sessions: a Mac menu bar app that runs Claude Code and
Codex sessions and exposes them over Tailscale, and a SwiftUI client for
iPhone, iPad and Mac that drives them."""

module(
    name = "visor",
    version = "0.53.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
# The BCR's apple_support 2.11.0, as rules_applecross (below) asks for: it
# has the fix the older one was patched for.
bazel_dep(name = "apple_support", version = "2.11.0")
# rules_swift from the project's registry (AttilaTheFun/bazel_registry,
# before the BCR in .bazelrc), as isomer asks for: 4.2.2.isomer.3 is
# upstream's 4.2.2 with isomer's pull requests (the wasm SDK's clang
# resource directory, Swift/C++ interop on Android, Android targets down to
# the Swift SDK's own minimum). It sorts above the 4.2.2 rules_applecross
# asks for, so no override holds it.
bazel_dep(name = "rules_swift", version = "4.2.2.isomer.3")

# The server's one C file (libraries/visor_server_posix/c); already in the
# graph at this version through rules_applecross.
bazel_dep(name = "rules_cc", version = "0.2.26")
# rules_apple from the project's registry: 5.3.1.applecross.6 is rules_apple
# 5.3.1 with rules_applecross's patches (bundling and signing on Linux),
# asking for rules_applecross 0.0.3.382f8c3, which asks for it back (a
# preset pair, as isomer has it).
bazel_dep(name = "rules_apple", version = "5.3.1.applecross.6")
# Visor's own patch on top: on a phone (the lab's iPhone), a UI test's runner
# app named as Xcode names a device's (<app>.xctrunner): a device finds no
# container for the simulator's "com.apple.test." name.
single_version_override(
    module_name = "rules_apple",
    patch_strip = 1,
    patches = ["//third_party/patches:rules_apple_device_xctrunner.patch"],
    version = "5.3.1.applecross.6",
)

# The Apple apps built on Linux (a container, a VM): rules_applecross (its
# clean-room actool, ibtool, codesign and swift-stdlib-tool, LLD), the Swift
# that built the Apple SDKs, and Xcode 27.2's SDKs, pinned by version and
# SHA-256. A Mac reads its own Xcode (local_xcode); elsewhere the SDK archive
# is fetched by its name below, a placeholder: each builder's .bazelrc.user
# says where it is, with `--distdir=<folder holding apple-sdks-27.2.tar.gz>`
# or a `--downloader_config` rewriting apple-sdks.invalid to where it is
# served (a Shireworks server's /files/sha256/<hex>, with its read token in .netrc).
# Without either, Linux fails to resolve apple-sdks.invalid. Its ported
# tools (the clean-room ones, built for Linux) come the same way, by their
# SHA-256 (third_party/applecross/ported_tools.sha256: newer than its last
# release, whose codesign can't seal a Mac app's nested code), from the same
# --distdir or a rewrite of ported-tools.invalid. The toolchains
# are registered for Linux alone, by the builder that has the SDKs
# (.bazelrc's apple_on_linux, turned on in .bazelrc.user), so a Mac builds
# as before and a Linux without them builds what runs on Linux.
# From the project's registry: 0.0.3.382f8c3 is rules_applecross's main at
# 382f8c3 (rules_apple's imported frameworks find its lipo on Linux, and
# ibtool fixes), the preset rules_apple above asks for, until it has a
# release in the BCR.
# Its actool and coremlc take Xcode 27.0 or 27.2 alone (else
# --config=relax_xcode_version).
bazel_dep(name = "rules_applecross", version = "0.0.3.382f8c3")
apple_cross_toolchain = use_extension("@rules_applecross//toolchain:extensions.bzl", "apple_cross_toolchain")
# The Swift that built Xcode 27.2's SDKs.
apple_cross_toolchain.swift(
    name = "applecross_swift",
    platform_sha256 = {
        "ubuntu24.04": "2e9ebec040ad459dd89a6d093a02d8314939135104850fae4d5c0f174fb3ba8c",
        "ubuntu24.04-aarch64": "307772afcc0b9501faa4797eb4197076facf5768593a0d8d2b83615c95b0040e",
        "xcode": "0a7d8489900d21dbf5f0187cb570e646a4c0226d0ddef2cbde8c7f54dfe79736",
    },
    swift_version = "6.4.2",
)
apple_cross_toolchain.configure(
    name = "apple_cross_toolchain",
    apple_sdk_urls = ["https://apple-sdks.invalid/apple-sdks-27.2.tar.gz"],
    local_xcode = True,
    ported_tools_manifest = "//third_party/applecross:ported_tools.sha256",
    ported_tools_urls = ["https://ported-tools.invalid/sha256/{sha256}"],
    swift_tools = {
        "aarch64": "@applecross_swift_ubuntu24.04-aarch64//:tools",
        "x86_64": "@applecross_swift_ubuntu24.04//:tools",
    },
    swift_tools_macos = "@applecross_swift_xcode//:tools",
    xcode_version = "27.2",
)
use_repo(apple_cross_toolchain, "apple_cross_toolchain")
# Where Apple products are bundled: on Linux with the clean-room tools, on a
# Mac with its Xcode.
register_toolchains(
    "@rules_applecross//toolchain:apple_bundling_on_linux",
    "@rules_applecross//toolchain:apple_bundling_on_macos",
)
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0.isomer.1")

# The chat, composer and navigation views: the agent_ui package, pinned by
# revision in third_party/swift_packages.
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//third_party/swift_packages:Package.resolved",
    swift = "//third_party/swift_packages:Package.swift",
)
# Isomer's Swift is a Swift package of the same graph (since 0.43: its
# README, "Upgrading isomer"), listed in third_party/swift_packages by its
# release's tag; the isomer module is handed to the generated repositories,
# so `@isomer//` resolves in them.
inject_repo(swift_deps, "isomer")
# AgentUI's targets are told where SwiftUI and Foundation come from: isomer's
# labels, which are Apple's own on Apple platforms (nothing to link), and
# Isomer's on the web and Android and in a compiled feature.
swift_deps.configure_package(
    name = "agent_ui",
    target_deps = {
        "AgentUI": ["@isomer//:swift_ui", "@isomer//:foundation"],
        "InboxUI": ["@isomer//:swift_ui", "@isomer//:foundation"],
        "MessagesCore": ["@isomer//:swift_ui", "@isomer//:foundation"],
        "MessagesUI": ["@isomer//:swift_ui", "@isomer//:foundation"],
        "MarkdownViews": ["@isomer//:swift_ui", "@isomer//:foundation"],
        "NavigationUI": ["@isomer//:swift_ui", "@isomer//:foundation"],
    },
)
# swift-nio's and swift-crypto's manifests add their privacy manifests only
# where `canImport(Darwin)`, which is false on Linux, where the manifests run
# when the Apple apps are built there: always, as on a Mac.
swift_deps.configure_package(
    name = "swift-nio",
    patch_cmds = ["sed -i.orig 's/^#if canImport(Darwin)$/#if true/' Package.swift"],
)
swift_deps.configure_package(
    name = "swift-crypto",
    patch_cmds = ["sed -i.orig 's/^#if canImport(Darwin)$/#if true/' Package.swift"],
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_agent_protocol",
    "swiftpkg_agent_ui",
    "swiftpkg_grpc_swift_2",
    "swiftpkg_grpc_swift_nio_transport",
    "swiftpkg_grpc_swift_protobuf",
    "swiftpkg_swift_protobuf",
    "swiftpkg_swift_asn1",
    "swiftpkg_swift_certificates",
    "swiftpkg_swift_collections",
    "swiftpkg_swift_crypto",
    "swiftpkg_swift_nio",
    "swiftpkg_swift_nio_ssl",
    "swiftpkg_swift_nio_ssh",
    "swiftpkg_swift_sql",
    "swiftpkg_update_kit",
)

# The builder's own signing values (the Apple team), from .bazelrc.user.
signing = use_extension("//tools/signing:extension.bzl", "signing")
use_repo(signing, "visor_signing")

# --- Isomer: SwiftUI for the web, Android, Linux and Windows, from the
# --- project's registry. The client's libraries import SwiftUI and
# --- Foundation through //:swift_ui and //:foundation, isomer's per-platform
# --- labels: Apple's own on Apple platforms, Isomer's elsewhere.
bazel_dep(name = "isomer", version = "0.50.1")


# isomer's Android cross-compile toolchains. The extension insists on a
# root-level android.sdk tag even when only the NDK's cc toolchains are used.
# The project registry's 0.5.0.isomer.1, which isomer asks for since 0.42: any
# Linux takes Google's x86_64 SDK and NDK tools (an arm64 Linux, a container
# on a Mac, runs them under Rosetta, with x86_64 glibc beside its own:
# tools/containers/visor-agent), with no override of Visor's own.
bazel_dep(name = "hermetic_android_toolchains", version = "0.5.0.isomer.1")

# A dev dependency (0.5.0 reads the root module's tags alone, and reports
# its repositories so): each root declares its own.
android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "35.0.0",
    version = "35",
)
android.ndk(
    api_level = 28,
    version = "r30",
)
use_repo(android, "androidndk", "androidsdk")

# isomer's web-app macro declares sh_binary dev servers.
bazel_dep(name = "rules_shell", version = "0.8.0")

# The swift.org toolchain with the WebAssembly and Android Swift SDKs.
swift = use_extension("@rules_swift//swift:extensions.bzl", "swift")
swift.toolchain(
    name = "swift_toolchain",
    swift_version = "6.4.2",
)
swift.wasm_sdk()
# No wasi-threads SDK beside it since isomer 0.41: it returns with Swift 6.5
# (isomer's TODO.md), and nothing of Visor's builds for it.
swift.android_sdk()
use_repo(swift, "swift_toolchain")

register_toolchains(
    "@swift_toolchain//:cc_toolchain_wasm32_xcode",
    "@swift_toolchain//:swift_toolchain_wasm32_xcode",
    "@swift_toolchain//:swift_toolchain_android_aarch64_xcode",
    "@swift_toolchain//:swift_toolchain_android_x86_64_xcode",
)

# A Linux host (GitHub's hosted runners): swift.org's ubuntu24.04 toolchain
# as the exec Swift toolchain, with the same wasm and Android SDKs. Fetched
# only when a Linux host resolves them.
register_toolchains(
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04-aarch64",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04-aarch64",
)

bazel_dep(name = "rules_android", version = "0.7.3")

rules_android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
    dev_dependency = True,
)
override_repo(rules_android_sdk, "androidsdk")

register_toolchains(
    "@androidndk//:all",
    "@androidsdk//:all",
    dev_dependency = True,
)

bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_kotlin", version = "2.2.2")
bazel_dep(name = "rules_python", version = "2.0.2")

# The transitively resolved rules_go is too old for Bazel 9; rules_applecross's
# graph raises it to 0.62.
bazel_dep(name = "rules_go", version = "0.62.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.12")

# rules_android's Maven graph, declared from the root (rules_jvm_external
# reads a lock file only from the root module), merging isomer's
# contribution; the lock is a copy of isomer's.
#   REPIN=1 bazel run @rules_android_maven//:pin
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "rules_android_maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    known_contributing_modules = [
        "rules_android",
        "isomer",
    ],
    lock_file = "//third_party/maven:rules_android_maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
    version_conflict_policy = "pinned",
)
use_repo(maven, "rules_android_maven")

android_tools = use_extension("@isomer//tools/android:extensions.bzl", "android_tools")
use_repo(
    android_tools,
    "android_build_tools",
    "android_emulator",
    "android_platform_jar",
    "android_platform_tools",
    "android_system_image",
    "hermetic_jdk",
    "kotlin_compiler",
)
