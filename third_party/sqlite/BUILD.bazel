load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")

package(default_visibility = ["//visibility:public"])

exports_files(["amalgamation.BUILD"])

# The C module the message cache imports (CSQLite): SQLite's API, from the
# system on Apple's systems and from SQLite's own source everywhere else.
# The default of `//:sqlite`; a host that builds SQLite its own way (for
# wasm, say) gives a library of the same module instead.
alias(
    name = "default",
    actual = select({
        "@platforms//os:ios": ":system",
        "@platforms//os:macos": ":system",
        "//conditions:default": ":bundled",
    }),
)

swift_interop_hint(
    name = "module",
    module_name = "CSQLite",
)

# The system's SQLite (the SDK's header, libsqlite3).
cc_library(
    name = "system",
    hdrs = ["csqlite.h"],
    aspect_hints = [":module"],
    linkopts = ["-lsqlite3"],
)

# SQLite's amalgamation, built here.
cc_library(
    name = "bundled",
    hdrs = ["csqlite.h"],
    aspect_hints = [":module"],
    deps = ["@sqlite_amalgamation//:sqlite3"],
)
