load("@rules_swift//swift:swift.bzl", "swift_test")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# Uninstall…'s plan (libraries/visor_uninstall), made from a fake
# filesystem and a fake keychain: nothing here reads or changes the real
# home folder, keychain or volumes. Foundation alone: on Linux, in
# //tests:linux, and on a Mac.
swift_test(
    name = "visor_uninstall_tests",
    copts = STRICT_SWIFT,
    srcs = glob(["*.swift"]),
    module_name = "VisorUninstallTests",
    deps = [
        "//:foundation",
        "//libraries/visor_disk_volumes",
        "//libraries/visor_uninstall",
    ],
)
