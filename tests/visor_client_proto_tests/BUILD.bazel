    name = "visor_client_proto_tests",
    copts = STRICT_SWIFT,
    srcs = glob(["*.swift"]),
    deps = [
        "//:foundation",
        "//libraries/visor_client_proto",
        "//libraries/visor_client_proto:visor_client_grpc_client",
        "//libraries/visor_client_proto:visor_client_grpc_server",
        "@swiftpkg_grpc_swift_2//:GRPCCore",
        "@swiftpkg_swift_protobuf//:SwiftProtobuf",
    ],
