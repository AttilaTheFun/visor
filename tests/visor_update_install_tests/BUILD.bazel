load("@rules_swift//swift:swift.bzl", "swift_test")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# Visor.app's check of a build Applications hands over
# (libraries/visor_update_install): a link, or anything not a folder,
# refused before anything runs; the copy out of the group's container, and
# codesign's check of it against the running app's identifier and team,
# with codesign and cp played by a fake runner, in a temporary folder.
# Foundation alone: on Linux, in //tests:linux, and on a Mac.
swift_test(
    name = "visor_update_install_tests",
    copts = STRICT_SWIFT,
    srcs = glob(["*.swift"]),
    module_name = "VisorUpdateInstallTests",
    deps = [
        "//:foundation",
        "//libraries/visor_update_install",
    ],
)
