load("@rules_apple//apple:ios.bzl", "ios_ui_test")
load("@rules_swift//swift:swift.bzl", "swift_library")

# Simulator probe for the client against Visor Server on this Mac, through
# its Tailscale Serve endpoint (VISOR_PROBE_HOST, the Mac's tailnet name):
# looks at screens, records a send, photographs the snapshot fixture.
# Screenshots go to /private/tmp/visor_probe (run with --spawn_strategy=local
# so the sandbox allows the write). Manual, one case at a time:
#   bazel test //tests/ios_probe:visor_probe --ios_multi_cpus=sim_arm64 \
#     --ios_simulator_device="iPhone 17" --ios_simulator_version=27.0 \
#     --spawn_strategy=local --nocache_test_results --test_output=errors \
#     --test_filter=VisorProbe/testFixtureScreens
# (docs/DEVELOPMENT.md has what each case needs.)

swift_library(
    name = "probe_lib",
    testonly = True,
    srcs = ["VisorProbe.swift"],
    module_name = "VisorProbe",
    tags = ["manual"],
)

ios_ui_test(
    name = "visor_probe",
    minimum_os_version = "18.0",
    tags = ["manual"],
    test_host = "//applications/visor_ios",
    # The test runs in about a minute; xcodebuild's teardown sometimes hangs
    # well past that, and Bazel's default 300s would report a pass as a timeout.
    timeout = "long",
    deps = [":probe_lib"],
)
