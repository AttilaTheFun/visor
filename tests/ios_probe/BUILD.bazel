load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_apple//apple:ios.bzl", "ios_application", "ios_ui_test")
load("@rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")
load("@rules_swift//swift:swift.bzl", "swift_library")

# Simulator probe for the client against Visor Server on this Mac
# (VISOR_PROBE_HOST, its address; VISOR_PROBE_PASSWORD):
# looks at screens, records a send, photographs the snapshot fixture.
# Screenshots go to /private/tmp/visor_probe (run with --spawn_strategy=local
# so the sandbox allows the write). Manual, one case at a time:
#   bazel test //tests/ios_probe:visor_probe --ios_multi_cpus=sim_arm64 \
#     --ios_simulator_device="iPhone 17" --ios_simulator_version=27.2 \
#     --spawn_strategy=local --nocache_test_results --test_output=errors \
#     --test_filter=VisorProbe/testFixtureScreens
# (docs/DEVELOPMENT.md has what each case needs.)

swift_library(
    name = "probe_lib",
    copts = STRICT_SWIFT,
    testonly = True,
    srcs = ["VisorProbe.swift"],
    module_name = "VisorProbe",
    tags = ["manual"],
    deps = ["//:foundation"],
)

# rules_apple's own runner, but for the simulator it makes or reuses
# (tools/ios_simulator: one whose runtime runs the device, which Xcode
# 27.2's first iOS 27.2 runtime does not): the device and version from
# --ios_simulator_device and --ios_simulator_version, the simulator
# BAZEL_TEST_<device>_<version>, as tools/ios_ui_tests.sh expects.
ios_xctestrun_runner(
    name = "simulator_runner",
    create_simulator_action = "//tools/ios_simulator:create",
    tags = ["manual"],
)

ios_ui_test(
    name = "visor_probe",
    # A run on its side: --test_env=VISOR_PROBE_ORIENTATION=landscape.
    env_inherit = ["VISOR_PROBE_ORIENTATION"],
    minimum_os_version = "18.0",
    runner = ":simulator_runner",
    tags = ["manual"],
    test_host = "//applications/visor_ios",
    # The test runs in about a minute; xcodebuild's teardown sometimes hangs
    # well past that, and Bazel's default 300s would report a pass as a timeout.
    timeout = "long",
    deps = [":probe_lib"],
)

# On a phone (the lab's iPhone): the same app, signed with the team's
# wildcard profile rather than its own. The test's runner app is signed with
# the profile of the app it tests, and only the wildcard covers the runner's
# bundle id; the wildcard cannot carry push, so this app has none, and no
# widget. Through the lab, with the lease's phone:
#   bazel test //tests/ios_probe:visor_probe_device --ios_multi_cpus=arm64 \
#     --test_arg=--destination=platform=iOS,id=$DEVICE_LAB_UDID \
#     --test_env=HOME="$HOME" --spawn_strategy=local --test_filter=…
# (HOME: the runner signs with the login keychain's identity, which a test's
# own HOME does not reach.)
ios_application(
    name = "probe_host",
    testonly = True,
    bundle_id = "com.LoganShire.VisorClient.iOS",
    entitlements = "probe_host.entitlements",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["//applications/visor_ios:Info.plist"],
    minimum_os_version = "18.0",
    provisioning_profile = "//applications/visor_ios:xcode_managed_profile",
    tags = ["manual"],
    deps = ["//applications/visor_ios:ios_lib"],
)

ios_ui_test(
    name = "visor_probe_device",
    # A run on its side: --test_env=VISOR_PROBE_ORIENTATION=landscape.
    env_inherit = ["VISOR_PROBE_ORIENTATION"],
    minimum_os_version = "18.0",
    tags = ["manual"],
    test_host = ":probe_host",
    timeout = "long",
    deps = [":probe_lib"],
)
