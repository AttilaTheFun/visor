load("@rules_swift//swift:swift.bzl", "swift_test")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# The portable services as Linux's client compiles them
# (//applications/visor_client_linux:native_services): the settings'
# launch values from the environment.
swift_test(
    name = "visor_services_tests",
    copts = STRICT_SWIFT,
    srcs = glob(["*.swift"]),
    module_name = "VisorServicesTests",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:foundation",
        "//applications/visor_client_linux:native_services",
        "//libraries/visor_services",
    ],
)
