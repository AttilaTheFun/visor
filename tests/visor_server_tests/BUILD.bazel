load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

swift_library(
    name = "visor_server_tests_lib",
    testonly = True,
    copts = STRICT_SWIFT,
    # The agents' host, which AgentHostTests runs: in the bundle's Resources.
    data = ["//applications/visor_agent_host:visor-agent-host"],
    # The Apple system's own tests, and what they share with the rest: the
    # others run on Linux (visor_server_linux_tests). By hand, on a Mac.
    srcs = ["ServerTestCase.swift", "ServerTests.swift"] + glob(["apple/*.swift"]),
    module_name = "VisorServerTests",
    # VisorSystem's and VisorAgent's `package` members are its to use.
    package_name = "visor",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//libraries/claude_transcript",
        "//libraries/message_cache",
        "//libraries/visor_agent",
        "//libraries/visor_mcp_bridge",
        "//libraries/visor_protocol",
        "//libraries/visor_server",
        "//libraries/visor_server_apple",
        "//libraries/visor_server_cli",
        "//libraries/visor_server_posix",
        "//libraries/visor_system",
    ],
)

# An .xctest bundle: built anywhere (on Linux too, with rules_applecross),
# run on a Mac by `bazel test` or by Shireworks (`tools/ci/shireworks.sh xctest`).
macos_unit_test(
    name = "visor_server_tests",
    minimum_os_version = "15.0",
    deps = [":visor_server_tests_lib"],
)

# The same tests but the Apple system's (apple/), on Linux's (linux/).
swift_test(
    name = "visor_server_linux_tests",
    copts = STRICT_SWIFT,
    srcs = glob(["*.swift", "linux/*.swift"]),
    module_name = "VisorServerTests",
    # VisorSystem's and VisorAgent's `package` members are its to use.
    package_name = "visor",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:foundation",
        "//libraries/claude_transcript",
        "//libraries/message_cache",
        "//libraries/visor_agent",
        "//libraries/visor_mcp_bridge",
        "//libraries/visor_protocol",
        "//libraries/visor_server",
        "//libraries/visor_server_cli",
        "//libraries/visor_server_linux",
        "//libraries/visor_server_posix",
        "//libraries/visor_system",
    ],
)
