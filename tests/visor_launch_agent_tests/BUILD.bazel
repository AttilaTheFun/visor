load("@rules_swift//swift:swift.bzl", "swift_test")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# Visor's LaunchAgents (libraries/visor_launch_agent): the app's own agent
# (its plist, the bundle's, checked against the code: the program the app
# itself, started again after a crash alone), what a launch of the app does
# and the lock that keeps it to one instance; the hand-back from the server
# agent with launchd and the server played by fakes; the server agent's
# job as settled; and the watchers, the app's relaunch's (AppRelaunchWatch)
# and the server agent's restart's, run for real with stand-ins for launchd
# and the server (their rollback, and a build that stays up). On Linux, in
# //tests:linux, as agent-proxy's are.
swift_test(
    name = "visor_launch_agent_tests",
    copts = STRICT_SWIFT,
    srcs = glob(["*.swift"]),
    module_name = "VisorLaunchAgentTests",
    data = [
        "//applications/visor_mac:LaunchAgents/com.LoganShire.Visor.app.plist",
        "//applications/visor_mac:LaunchAgents/com.LoganShire.Visor.server.plist",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//:foundation",
        "//libraries/visor_launch_agent",
        "//libraries/visor_server",
    ],
)
