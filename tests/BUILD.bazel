# The tests that run on Linux, in verify's linux job (a Linux container):
# the server's (its Apple system's apart, by hand on a Mac), the driver's,
# the message cache's, the transcript parser's, the Runner agent's, the
# native settings' launch values (visor_services_tests), agent-proxy's and
# relay-client's, and the Disk Utility's volume model's.
test_suite(
    name = "linux",
    tests = [
        "//tests/claude_transcript_tests",
        "//tests/message_cache_tests",
        "//tests/visor_agent_proxy_tests",
        "//tests/visor_agent_proxy_tests:relay_client_tests",
        "//tests/visor_disk_volumes_tests",
        "//tests/visor_driver_tests",
        "//tests/visor_server_tests:visor_server_linux_tests",
        "//tests/visor_services_tests",
    ],
)
