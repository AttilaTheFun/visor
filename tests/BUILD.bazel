# the message cache's, the transcript parser's and the Runner agent's.
test_suite(
    name = "linux",
    tests = [
        "//tests/claude_transcript_tests",
        "//tests/message_cache_tests",
        "//tests/visor_driver_tests",
        "//tests/visor_runner_tests",
        "//tests/visor_server_tests:visor_server_linux_tests",
    ],
)
