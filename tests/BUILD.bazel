# the message cache's, the transcript parser's, the Runner agent's and the
# native settings' launch values (visor_services_tests).
test_suite(
    name = "linux",
    tests = [
        "//tests/claude_transcript_tests",
        "//tests/message_cache_tests",
        "//tests/visor_driver_tests",
        "//tests/visor_server_tests:visor_server_linux_tests",
        "//tests/visor_services_tests",
    ],
)
