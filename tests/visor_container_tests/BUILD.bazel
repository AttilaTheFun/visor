load("@rules_swift//swift:swift.bzl", "swift_test")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# The Sessions container's core (libraries/visor_container's): the pins and
# container.json, the layout on the Containers volume, fetching and checking
# assets against a fake backend, Visor's Linux programs under the link rule
# (dangling, absolute and escaping links refused), Settings' readiness row;
# the engine against a fake VM backend (its boot, the link check and the
# egress check, no egress refusing processes, first use, the idle stop, the
# start with a server, the root filesystem, a crash), and HostRelay against
# a fake agent-proxy relay (the header's bytes, the splice) and agent-proxy's
# own relay listener (relay-client check's health answer); the driver link
# (carried in, no header, no agent-proxy needed) and startWrapper's argv and
# environment; a stop on purpose held, a restart, and the container
# runner's agent exec'd (VisorContainerRunner). No VM: on Linux, in
# //tests:linux, and on a Mac.
swift_test(
    name = "visor_container_tests",
    copts = STRICT_SWIFT,
    srcs = [
        "AssetsTests.swift",
        "EngineTests.swift",
        "EngineTests+Runner.swift",
        "EngineTests+Wrapper.swift",
        "FakeBackend.swift",
        "FakeMachines.swift",
        "HostRelayTests.swift",
        "LoopbackPorts.swift",
        "PinsTests.swift",
        "ReadinessTests.swift",
        "ToolsFolderTests.swift",
    ],
    module_name = "VisorContainerTests",
    deps = [
        "//:foundation",
        "//libraries/visor_agent_proxy",
        "//libraries/visor_agent_proxy:agent_proxy_c",
        "//libraries/visor_agent_proxy:visor_agent_proxy_host",
        "//libraries/visor_container:visor_container_core",
        "//libraries/visor_container:visor_container_runner",
        "//libraries/visor_disk_volumes",
        "//libraries/visor_protocol",
        "//libraries/visor_server",
        "@swiftpkg_swift_crypto//:Crypto",
    ],
)

# The Mac's half: this Mac's readiness and memory, and the Containerization
# backend taking a member out of an archive. macOS alone; pulling a real
# image is //tools/e2e/container_assets's (it needs the network).
swift_test(
    name = "visor_container_mac_tests",
    copts = STRICT_SWIFT,
    srcs = ["HostTests.swift"],
    module_name = "VisorContainerMacTests",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//:foundation",
        "//libraries/visor_container",
        "//libraries/visor_container:visor_container_core",
    ],
)
