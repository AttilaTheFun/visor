load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# Where the Mac's programs keep their secrets: the keychain in notarized
# builds (alpha, production: `--config=notarized`, tools/release_mac.sh),
# the data folder in debug builds, which aren't signed the same way twice
# and would have the keychain ask each time.
bool_flag(
    name = "keychain",
    build_setting_default = False,
)

config_setting(
    name = "in_keychain",
    flag_values = {":keychain": "True"},
)
