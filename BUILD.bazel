load(
    "@rules_xcodeproj//xcodeproj:defs.bzl",
    "top_level_target",
    "xcodeproj",
)

package(default_visibility = ["//visibility:public"])

# Where `import SwiftUI` comes from: isomer's label, which is the system
# framework on Apple's platforms (nothing to link) and Isomer's on the web,
# Android, Linux and Windows and in a feature compiled against Isomer's
# frameworks. A host with a SwiftUI of its own may still set the flag:
#   --@visor//:swift_ui=@<host>//:swift_ui
label_flag(
    name = "swift_ui",
    build_setting_default = "@isomer//:swift_ui",
)

# Where `import Foundation` comes from, the same way: isomer's label, the
# system's on Apple's platforms, Linux and Windows, and Isomer's on the web
# and Android:
#   --@visor//:foundation=@<host>//:foundation
label_flag(
    name = "foundation",
    build_setting_default = "@isomer//:foundation",
)

# The system pasteboard (module VisorPasteboard: `Pasteboard.string`): by
# default AppKit's or UIKit's, none elsewhere. A host with a clipboard of
# its own sets the flag to its library of that module:
#   --@visor//:pasteboard=@<host>//:pasteboard
label_flag(
    name = "pasteboard",
    build_setting_default = "//libraries/visor_pasteboard",
)

# The camera (module VisorCamera: `Camera.available` and the `cameraCapture`
# modifier): by default UIKit's picker on an iPhone or iPad, none elsewhere.
# A host with a camera of its own sets the flag to its library of that
# module:
#   --@visor//:camera=@<host>//:camera
label_flag(
    name = "camera",
    build_setting_default = "//libraries/visor_camera",
)

xcodeproj(
    name = "xcodeproj",
    project_name = "Visor",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            "//applications/visor_ios",
            target_environments = [
                "device",
                "simulator",
            ],
        ),
        "//applications/visor_macos",
        "//applications/visor_menubar",
    ],
)
