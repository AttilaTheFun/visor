load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift.bzl", "swift_library")
load(
    "@rules_xcodeproj//xcodeproj:defs.bzl",
    "top_level_target",
    "xcodeproj",
)

package(default_visibility = ["//visibility:public"])

# Where `import SwiftUI` comes from. On Apple it is the system framework and
# this points at nothing; a host that carries the client elsewhere (a
# browser, Android, Linux, Windows) sets the flag to its own SwiftUI:
#   --@visor//:swift_ui=@<host>//:swift_ui
label_flag(
    name = "swift_ui",
    build_setting_default = ":system_swift_ui",
)

# The system SwiftUI: nothing to link, the import is implicit.
swift_library(
    name = "system_swift_ui",
    srcs = ["SystemSwiftUI.swift"],
    module_name = "VisorSystemSwiftUI",
)

# Where `import Foundation` comes from, the same way: on Apple the system's,
# and this points at nothing; a host whose platform has no Foundation of its
# own (a browser, Android) sets it to the one it builds:
#   --@visor//:foundation=@<host>//:foundation
label_flag(
    name = "foundation",
    build_setting_default = ":system_foundation",
)

# The system Foundation: nothing to link, the import is implicit.
cc_library(name = "system_foundation")

# The system pasteboard (module VisorPasteboard: `Pasteboard.string`): by
# default AppKit's or UIKit's, none elsewhere. A host with a clipboard of
# its own sets the flag to its library of that module:
#   --@visor//:pasteboard=@<host>//:pasteboard
label_flag(
    name = "pasteboard",
    build_setting_default = "//libraries/visor_pasteboard",
)

# SQLite, for the message cache (a C module, CSQLite, with SQLite's API
# and its full-text index, FTS5): by default the system's on Apple's
# systems and SQLite's amalgamation built here elsewhere. A host that builds
# SQLite its own way (for wasm, with its own file system) sets the flag to
# its library of that module:
#   --@visor//:sqlite=@<host>//:sqlite
label_flag(
    name = "sqlite",
    build_setting_default = "//third_party/sqlite:default",
)

# The camera (module VisorCamera: `Camera.available` and the `cameraCapture`
# modifier): by default UIKit's picker on an iPhone or iPad, none elsewhere.
# A host with a camera of its own sets the flag to its library of that
# module:
#   --@visor//:camera=@<host>//:camera
label_flag(
    name = "camera",
    build_setting_default = "//libraries/visor_camera",
)

xcodeproj(
    name = "xcodeproj",
    project_name = "Visor",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            "//applications/visor_ios",
            target_environments = [
                "device",
                "simulator",
            ],
        ),
        "//applications/visor_macos",
        "//applications/visor_menubar",
    ],
)
